\f0\b\fs28 \cf0 Question:\
\pard\tx560\tx1120\tx1680\tx2240\tx2800\tx3360\tx3920\tx4480\tx5040\tx5600\tx6160\tx6720\sl324\slmult1\pardirnatural\partightenfactor0

\f1 \cf0 create an F# script that takes lists the contents of diskutil in a structured way, ie a table.  It should also allow you to identify external drives, drives connected via a USB drive, drives connected to the internet etc.\
\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 \expnd0\expndtw0\kerning0
On macOS, 
\f3\fs26 diskutil list
\f2\fs24  is designed for humans, not machines, so parsing it directly is brittle. A much better approach is to use:\
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls1\ilvl0
\f3\fs26 \cf0 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
diskutil list -plist
\f2\fs24  (structured XML)\
\ls1\ilvl0
\f3\fs26 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
diskutil info -plist <device>
\f2\fs24  (detailed information)\
\ls1\ilvl0
\f3\fs26 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
system_profiler SPUSBDataType -json
\f2\fs24  (USB topology)\
\ls1\ilvl0
\f3\fs26 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
system_profiler SPThunderboltDataType -json
\f2\fs24  (Thunderbolt devices)\
\ls1\ilvl0
\f3\fs26 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
system_profiler SPNVMeDataType -json
\f2\fs24  (NVMe drives)\
\ls1\ilvl0
\f3\fs26 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
mount
\f2\fs24  (network filesystems)\
\ls1\ilvl0
\f3\fs26 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
diskutil apfs list -plist
\f2\fs24  (APFS information)\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 Below is an F# script (
\f3\fs26 DiskInventory.fsx
\f2\fs24 ) that produces a structured table and attempts to classify drives.\
\pard\pardeftab720\partightenfactor0

\f3\fs26 \cf0 #r "System.Xml.Linq.dll"\
\
open System\
open System.IO\
open System.Xml.Linq\
open System.Diagnostics\
\
//--------------------------------------------------------------\
// Helpers\
//--------------------------------------------------------------\
\
let run command args =\
    let psi = ProcessStartInfo(command, args)\
    psi.RedirectStandardOutput <- true\
    psi.RedirectStandardError <- true\
    psi.UseShellExecute <- false\
\
    use p = Process.Start(psi)\
    let output = p.StandardOutput.ReadToEnd()\
    let err = p.StandardError.ReadToEnd()\
\
    p.WaitForExit()\
\
    if p.ExitCode <> 0 then\
        failwith err\
\
    output\
\
//--------------------------------------------------------------\
// Read plist\
//--------------------------------------------------------------\
\
let plist device =\
    run "diskutil" $"info -plist \{device\}"\
\
let plistList =\
    run "diskutil" "list -plist"\
\
let doc = XDocument.Parse(plistList)\
\
let dict =\
    doc.Root.Element(XName.Get "dict")\
\
let rec valueAfter (key:string) (dict:XElement) =\
    dict.Elements()\
    |> Seq.pairwise\
    |> Seq.tryFind(fun (k,v) ->\
        k.Name.LocalName="key" &&\
        k.Value=key)\
    |> Option.map snd\
\
//--------------------------------------------------------------\
// Devices\
//--------------------------------------------------------------\
\
let allDevices =\
    valueAfter "AllDisksAndPartitions" dict\
    |> Option.get\
    |> fun arr ->\
        arr.Elements(XName.Get "dict")\
        |> Seq.choose(fun d ->\
            valueAfter "DeviceIdentifier" d\
            |> Option.map(fun x -> x.Value))\
        |> Seq.toList\
\
//--------------------------------------------------------------\
// Individual drive info\
//--------------------------------------------------------------\
\
type DriveInfo =\
    \{\
        Device : string\
        SizeGB : float\
        Protocol : string\
        Internal : bool\
        Virtual : bool\
        Removable : bool\
        ReadOnly : bool\
        SolidState : bool\
        VolumeName : string\
        FileSystem : string\
        Mounted : bool\
        Connection : string\
    \}\
\
let boolValue key dict =\
    valueAfter key dict\
    |> Option.map(fun x -> x.Name.LocalName="true")\
    |> Option.defaultValue false\
\
let stringValue key dict =\
    valueAfter key dict\
    |> Option.map(fun x -> x.Value)\
    |> Option.defaultValue ""\
\
let floatValue key dict =\
    valueAfter key dict\
    |> Option.bind(fun x ->\
        match Double.TryParse x.Value with\
        | true,v -> Some v\
        | _ -> None)\
    |> Option.defaultValue 0.0\
\
let classify protocol internalDrive removable =\
    if protocol.Contains("USB") then\
        "USB"\
\
    elif protocol.Contains("Thunderbolt") then\
        "Thunderbolt"\
\
    elif protocol.Contains("PCI") then\
        "Internal PCIe"\
\
    elif protocol.Contains("SATA") then\
        "SATA"\
\
    elif not internalDrive then\
        "External"\
\
    elif removable then\
        "Removable"\
\
    else\
        "Internal"\
\
let drives =\
\
    allDevices\
\
    |> List.map(fun d ->\
\
        let xml = XDocument.Parse(plist d)\
\
        let dict = xml.Root.Element(XName.Get "dict")\
\
        let protocol = stringValue "BusProtocol" dict\
        let internalDrive = boolValue "Internal" dict\
        let removable = boolValue "Removable" dict\
\
        \{\
            Device = d\
            SizeGB = floatValue "TotalSize" dict / 1e9\
            Protocol = protocol\
            Internal = internalDrive\
            Virtual = boolValue "VirtualOrPhysical" dict |> not\
            Removable = removable\
            ReadOnly = boolValue "ReadOnlyMedia" dict\
            SolidState = boolValue "SolidState" dict\
            VolumeName = stringValue "VolumeName" dict\
            FileSystem = stringValue "FilesystemName" dict\
            Mounted = boolValue "Mounted" dict\
            Connection = classify protocol internalDrive removable\
        \})\
\
//--------------------------------------------------------------\
// Print table\
//--------------------------------------------------------------\
\
printfn ""\
\
printfn "%-10s %-15s %-9s %-10s %-10s %-8s %-8s %-10s %-15s %-10s"\
    "Device"\
    "Connection"\
    "SizeGB"\
    "SSD"\
    "Mounted"\
    "Internal"\
    "RO"\
    "Filesystem"\
    "Volume"\
    "Protocol"\
\
printfn "%s" (String.replicate 120 "-")\
\
for d in drives do\
\
    printfn "%-10s %-15s %-9.1f %-10b %-10b %-8b %-8b %-10s %-15s %-10s"\
        d.Device\
        d.Connection\
        d.SizeGB\
        d.SolidState\
        d.Mounted\
        d.Internal\
        d.ReadOnly\
        d.FileSystem\
        d.VolumeName\
        d.Protocol\
\pard\pardeftab720\sa240\partightenfactor0

