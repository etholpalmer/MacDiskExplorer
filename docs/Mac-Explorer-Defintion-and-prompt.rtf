\f3\fs26 \cf0 type ICollector =\
    abstract Name : string\
    abstract Collect : Inventory -> Async<Inventory>\
\pard\pardeftab720\sa240\partightenfactor0

\f2\fs24 \cf0 This would let you add new collectors\'97such as 
